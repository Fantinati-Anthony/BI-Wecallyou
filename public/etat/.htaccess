# Fichiers d'état « prêt » écrits par le serveur Node. Lus par les pages client en secours du temps réel.
# Ticket pas encore appelé = 404 « attente ». Les deux réponses sont gardées 2 s en cache.
Options -Indexes
ErrorDocument 404 "attente"

<IfModule mod_headers.c>
  Header always set Cache-Control "public, max-age=2"
  Header always set X-Content-Type-Options "nosniff"
</IfModule>

# Ce dossier ne doit jamais exécuter de code
<FilesMatch "\.(php|phtml|cgi|pl|py|js|mjs|cjs)$">
  Require all denied
</FilesMatch>
